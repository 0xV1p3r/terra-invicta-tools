{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Terra Invicta Tools",
	"version": "../package.json",
	"identifier": "dev.terra-invicta-tools.tech-tree",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../build"
	},
	"app": {
		"windows": [
			{
				"title": "Terra Invicta Tools",
				"width": 1720,
				"height": 1000,
				"minWidth": 1100,
				"minHeight": 720
			}
		],
		"security": {
			"csp": {
				"default-src": "'self'",
				"script-src": "'self'",
				"style-src": "'self' 'unsafe-inline'",
				"img-src": "'self' data: blob: tiasset: http://tiasset.localhost",
				"font-src": "'self' data:",
				"connect-src": "ipc: http://ipc.localhost",
				"object-src": "'none'",
				"base-uri": "'none'",
				"form-action": "'none'"
			},
			"dangerousDisableAssetCspModification": ["style-src"]
		}
	},
	"bundle": {
		"active": true,
		"targets": ["deb", "appimage", "nsis"],
		"publisher": "0xV1p3r",
		"copyright": "Copyright © 2026 0xV1p3r. Not affiliated with Pavonis Interactive or Hooded Horse.",
		"license": "MIT",
		"homepage": "https://github.com/0xV1p3r/terra-invicta-tools",
		"category": "StrategyGame",
		"shortDescription": "Research tree, wiki and solar system map for Terra Invicta",
		"longDescription": "Unofficial desktop tools for Terra Invicta. The app reads the data of your installed copy of the game and shows the research tree, a wiki and a solar system map. No game data is included.",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/icon.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
